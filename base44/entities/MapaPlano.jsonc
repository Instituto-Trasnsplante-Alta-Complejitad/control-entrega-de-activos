{
  "name": "MapaPlano",
  "type": "object",
  "properties": {
    "sede_id": {
      "type": "string",
      "description": "ID de la sede"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre del plano (ej: Subsuelo, Planta baja)"
    },
    "imagen_url": {
      "type": "string",
      "description": "URL de la imagen del plano"
    },
    "orden": {
      "type": "number",
      "default": 0,
      "description": "Orden de visualizaci\u00f3n"
    }
  },
  "required": [
    "sede_id",
    "nombre",
    "imagen_url",
    "orden"
  ]
}