{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "component_stock_id": {
      "type": "string",
      "description": "ID del \u00edtem en ComponentStock"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo del \u00edtem"
    },
    "tipo_movimiento": {
      "type": "string",
      "enum": [
        "entrada",
        "salida",
        "ajuste",
        "instalacion",
        "retiro",
        "baja"
      ],
      "description": "Tipo de movimiento"
    },
    "cantidad": {
      "type": "number"
    },
    "cantidad_anterior": {
      "type": "number"
    },
    "cantidad_nueva": {
      "type": "number"
    },
    "motivo": {
      "type": "string"
    },
    "referencia_id": {
      "type": "string",
      "description": "ID de entrega o equipo relacionado"
    },
    "referencia_tipo": {
      "type": "string",
      "description": "Tipo: equipo, impresora, ajuste"
    },
    "usuario_responsable": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "observaciones": {
      "type": "string"
    }
  },
  "required": [
    "component_stock_id",
    "tipo_movimiento",
    "cantidad",
    "fecha"
  ]
}