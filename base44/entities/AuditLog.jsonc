{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "usuario_email": {
      "type": "string",
      "description": "Email del usuario que realiz\u00f3 la acci\u00f3n"
    },
    "usuario_nombre": {
      "type": "string",
      "description": "Nombre completo del usuario"
    },
    "accion": {
      "type": "string",
      "enum": [
        "crear",
        "editar",
        "eliminar",
        "ajuste_stock",
        "editar_consumo",
        "cambio_compatibilidad",
        "baja"
      ],
      "description": "Tipo de acci\u00f3n realizada"
    },
    "entidad": {
      "type": "string",
      "description": "Entidad afectada (Equipment, Printer, ComponentStock, StockMovement, PrinterDelivery)"
    },
    "entidad_id": {
      "type": "string",
      "description": "ID del registro afectado"
    },
    "entidad_label": {
      "type": "string",
      "description": "Descripci\u00f3n legible del registro (ej: asset_number, printer_id, c\u00f3digo)"
    },
    "valor_anterior": {
      "type": "string",
      "description": "Valor anterior (JSON si m\u00faltiples campos)"
    },
    "valor_nuevo": {
      "type": "string",
      "description": "Valor nuevo (JSON si m\u00faltiples campos)"
    },
    "observacion": {
      "type": "string",
      "description": "Nota adicional"
    },
    "fecha": {
      "type": "string",
      "description": "Fecha y hora ISO de la acci\u00f3n"
    }
  },
  "required": [
    "accion",
    "entidad",
    "usuario_email"
  ]
}