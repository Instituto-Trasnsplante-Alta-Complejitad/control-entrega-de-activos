{
  "name": "Printer",
  "type": "object",
  "properties": {
    "numero": {
      "type": "number",
      "description": "N\u00famero correlativo"
    },
    "printer_id": {
      "type": "string",
      "description": "ID \u00fanico de impresora (ej: AR2150P001)"
    },
    "marca": {
      "type": "string"
    },
    "modelo": {
      "type": "string"
    },
    "piso": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "edificio": {
      "type": "string"
    },
    "conexion": {
      "type": "string",
      "description": "IP o tipo de conexi\u00f3n"
    },
    "toner": {
      "type": "string",
      "description": "C\u00f3digo de toner compatible"
    },
    "unidad_imagen": {
      "type": "string",
      "description": "C\u00f3digo de unidad de imagen compatible"
    },
    "proveedor": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "activa",
        "inactiva",
        "en_reparacion",
        "baja"
      ],
      "default": "activa"
    }
  },
  "required": [
    "printer_id",
    "marca",
    "modelo"
  ]
}