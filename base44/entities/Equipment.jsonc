{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "asset_number": {
      "type": "string",
      "description": "C\u00f3digo de equipo (ej: AR2150L002)"
    },
    "type": {
      "type": "string",
      "enum": [
        "notebook",
        "tablet",
        "celular",
        "cpu",
        "otro"
      ],
      "description": "Tipo de equipo"
    },
    "subtype": {
      "type": "string",
      "description": "Subtipo del equipo (ej: scanner, ups, switch)"
    },
    "brand": {
      "type": "string",
      "description": "Marca del equipo"
    },
    "model": {
      "type": "string",
      "description": "Modelo del equipo"
    },
    "serial_number": {
      "type": "string",
      "description": "N\u00famero de serie"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponible",
        "asignado",
        "baja",
        "en_reparacion"
      ],
      "default": "disponible",
      "description": "Estado del equipo"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "interno",
        "externo"
      ],
      "description": "Tipo de usuario: interno o externo a ITAC"
    },
    "assigned_to": {
      "type": "string",
      "description": "Apellido y Nombre del usuario asignado"
    },
    "username": {
      "type": "string",
      "description": "Usuario de red (ej: glalnph)"
    },
    "department": {
      "type": "string",
      "description": "Ubicaci\u00f3n / Sector"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de entrega"
    },
    "comments": {
      "type": "string",
      "description": "Observaciones"
    },
    "peripherals_mouse": {
      "type": "boolean",
      "default": false,
      "description": "Mouse incluido"
    },
    "peripherals_keyboard": {
      "type": "boolean",
      "default": false,
      "description": "Teclado incluido"
    },
    "peripherals_monitor": {
      "type": "boolean",
      "default": false,
      "description": "Monitor incluido"
    },
    "peripherals_camera": {
      "type": "boolean",
      "default": false,
      "description": "C\u00e1mara incluida"
    },
    "processor_model": {
      "type": "string",
      "description": "Modelo del procesador"
    },
    "storage_capacity": {
      "type": "string",
      "description": "Capacidad de almacenamiento (ej: 512 GB)"
    },
    "storage_type": {
      "type": "string",
      "enum": [
        "HDD",
        "SSD",
        "NVMe"
      ],
      "description": "Tipo de almacenamiento"
    },
    "ram_amount": {
      "type": "string",
      "description": "Cantidad de RAM (ej: 16 GB)"
    },
    "ram_slots": {
      "type": "number",
      "description": "Slots utilizados de RAM"
    },
    "ram_speed": {
      "type": "string",
      "description": "Velocidad de RAM (ej: 3200 MHz)"
    },
    "ram_generation": {
      "type": "string",
      "description": "Generaci\u00f3n de RAM (ej: DDR4)"
    },
    "ram_format": {
      "type": "string",
      "description": "Formato de RAM (ej: DIMM, SO-DIMM)"
    },
    "operating_system": {
      "type": "string",
      "description": "Sistema operativo instalado"
    },
    "ocs_id": {
      "type": "number",
      "description": "ID interno de OCS Inventory"
    },
    "ocs_lastdate": {
      "type": "string",
      "description": "Fecha del \u00faltimo inventario OCS"
    },
    "ocs_is_outdated": {
      "type": "boolean",
      "default": false,
      "description": "True si no tuvo reporte OCS en los \u00faltimos 20 d\u00edas"
    },
    "ocs_days_without_report": {
      "type": "number",
      "description": "D\u00edas desde el \u00faltimo reporte OCS"
    }
  },
  "required": [
    "asset_number",
    "type",
    "brand",
    "model",
    "serial_number"
  ]
}