{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "asset_number": {
      "type": "string",
      "description": "N\u00famero de activo (ej: AR2150L002)"
    },
    "type": {
      "type": "string",
      "enum": [
        "notebook",
        "tablet",
        "celular",
        "cpu",
        "otro"
      ],
      "description": "Tipo de equipo"
    },
    "brand": {
      "type": "string",
      "description": "Marca del equipo"
    },
    "model": {
      "type": "string",
      "description": "Modelo del equipo"
    },
    "serial_number": {
      "type": "string",
      "description": "N\u00famero de serie"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponible",
        "asignado",
        "baja",
        "en_reparacion"
      ],
      "default": "disponible",
      "description": "Estado del equipo"
    },
    "department": {
      "type": "string",
      "description": "Gerencia o sector"
    },
    "comments": {
      "type": "string",
      "description": "Comentarios adicionales"
    }
  },
  "required": [
    "asset_number",
    "type",
    "brand",
    "model",
    "serial_number"
  ]
}