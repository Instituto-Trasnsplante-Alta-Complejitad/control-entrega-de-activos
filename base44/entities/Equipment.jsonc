{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "asset_number": {
      "type": "string",
      "description": "C\u00f3digo de equipo (ej: AR2150L002)"
    },
    "type": {
      "type": "string",
      "enum": [
        "notebook",
        "tablet",
        "celular",
        "cpu",
        "otro"
      ],
      "description": "Tipo de equipo"
    },
    "brand": {
      "type": "string",
      "description": "Marca del equipo"
    },
    "model": {
      "type": "string",
      "description": "Modelo del equipo"
    },
    "serial_number": {
      "type": "string",
      "description": "N\u00famero de serie"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponible",
        "asignado",
        "baja",
        "en_reparacion"
      ],
      "default": "disponible",
      "description": "Estado del equipo"
    },
    "assigned_to": {
      "type": "string",
      "description": "Apellido y Nombre del usuario asignado"
    },
    "username": {
      "type": "string",
      "description": "Usuario de red (ej: glalnph)"
    },
    "department": {
      "type": "string",
      "description": "Ubicaci\u00f3n / Sector"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de entrega"
    },
    "comments": {
      "type": "string",
      "description": "Observaciones"
    }
  },
  "required": [
    "asset_number",
    "type",
    "brand",
    "model",
    "serial_number"
  ],
  "rls": {
    "create": {
      "authenticated": true
    },
    "read": {
      "authenticated": true
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}