DATABASE_URL="postgresql://control_activos_app:change-me@postgres:5432/control_entrega_activos?schema=public"

# Public URL used by the browser and OIDC redirects.
APP_URL="https://apps.ad.itac.com.ar/activos"
APP_BASE_PATH="/activos"

# Keycloak OIDC configuration. Store the real secret in Docker secrets.
KEYCLOAK_ISSUER="https://apps.ad.itac.com.ar/auth/realms/itac"
KEYCLOAK_CLIENT_ID="control-entrega-activos"
KEYCLOAK_CLIENT_SECRET_FILE="/run/secrets/keycloak_client_secret"

# Authorization is based on Keycloak/AD groups, never only on the email domain.
APP_ADMIN_GROUP="/ARR-ITAC-IT"
APP_ADMIN_ROLE="control-activos-admin"
APP_ALLOWED_GROUPS="/ARR-ITAC-IT"
APP_ALLOWED_ROLE=""

# Persistent storage for floor-plan images and generated documents.
STORAGE_PATH="/data/control-entrega-activos"
PORT="8080"

# OCS Inventory. The application synchronizes once every 24 hours by default.
OCS_BASE_URL="http://inventario.ad.itac.com.ar/ocsapi/v1"
OCS_WARNING_HOURS="24"
OCS_CRITICAL_DAYS="7"
OCS_REPORT_DAYS="30"
OCS_SYNC_INTERVAL_HOURS="24"
OCS_RETRY_INTERVAL_MINUTES="60"
OCS_AUTO_SYNC="true"
OCS_TIMEOUT_MS="20000"
OCS_CONCURRENCY="6"
OCS_CREATE_MISSING="false"
MIN_RAM_GB="8"
CRITICAL_RAM_GB="4"
RENEWAL_MIN_SCORE="3"
OLD_OS_PATTERNS="windows xp,windows vista,windows 7,windows 8"

# Configure only when the OCS API requires authentication. Prefer HTTPS when
# credentials are used, and store the real values as Docker secrets.
OCS_USER_FILE="/run/secrets/ocs_user"
OCS_PASSWORD_FILE="/run/secrets/ocs_password"
